{
    "schemaVersion": 1,
    "id": "constellation",
    "version": "${version}",
    "name": "Constellation",
    "description": "A modular Hypixel SkyBlock client with shared configuration, HUD and game-state tooling.",
    "authors": ["Froggy__Lord"],
    "contact": {
        "homepage": "https://github.com/Froggy-Lord/Constellation",
        "sources": "https://github.com/Froggy-Lord/Constellation",
        "issues": "https://github.com/Froggy-Lord/Constellation/issues"
    },
    "license": "GPL-3.0-only",
    "icon": "assets/constellation/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.froggylord.constellation.ConstellationClient"
        ],
        "modmenu": [
            "com.froggylord.constellation.ui.ModMenuIntegration"
        ]
    },
    "mixins": [
        "constellation.mixins.json"
    ],
    "accessWidener": "constellation.accesswidener",
    "depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": "~26.2",
        "java": ">=25",
        "fabric-api": "*"
    },
    "suggests": {
        "modmenu": "*"
    }
}
